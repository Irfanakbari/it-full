# PostgreSQL
POSTGRES_USER=itam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itam
POSTGRES_PORT=55432
DATABASE_URL=postgresql://itam:change-me@postgres:5432/itam?schema=public

# Docker runtime
NODE_ENV=development
API_URL=http://api:7600

# Vuteq SSO (server only; never prefix secrets with NEXT_PUBLIC_)
VUTEQ_SSO_BASE_URL=https://sso.vuteq.co.id
VUTEQ_SSO_SECRET=replace-with-confidential-client-secret
VUTEQ_SSO_PUBLIC_ORIGIN=http://localhost:3000
VUTEQ_SSO_TRUST_PROXY=false
VUTEQ_SSO_ALLOWED_CLIENT_IDS=

# ESSA/HRIS employee directory (API server only)
ESSA_API_URL=https://essa.vuteq.co.id/connector
ESSA_API_KEY=replace-with-essa-api-key
ESSA_API_TIMEOUT_MS=5000

# Synology FileStation (API server only)
NAS_HOST=nas.internal.example
NAS_PORT=5001
NAS_PROTOCOL=https
NAS_USER=replace-with-nas-service-account
NAS_PASSWORD=replace-with-nas-password
NAS_SMB_SHARE=AssetStorage
NAS_SMB_SUBFOLDER=ItAssetAttachments
NAS_BASE_URL=https://nas-files.example/ItAssetAttachments/

# Redis-backed BFF sessions
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
VUTEQ_SSO_REDIS_DB=0
VUTEQ_SSO_REDIS_KEY_PREFIX=

# 32-byte key encoded as Base64 (for example: openssl rand -base64 32)
LICENSE_ENCRYPTION_KEY=replace-with-32-byte-base64-key

SWAGGER_ENABLED=true
SWAGGER_API_KEY=
